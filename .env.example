# Identifies this app (not a user) to Telegram. One pair for the whole server,
# registered once by whoever runs it; every user still logs in with their own
# phone number. Get them at https://my.telegram.org -> "API development tools".
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Secret used to encrypt stored Telegram sessions: any long random string
# (`make key` prints a good one). Changing it later logs everyone out.
# If left empty, a key is generated on first start and saved to DATA_DIR/secret.key
SECRET_KEY=

# Who can open the admin panel (/admin.html): Telegram user ids or phone
# numbers (international format), separated by commas. They log in like
# everyone else. Your user id is shown in the account menu once logged in.
# Example: ADMINS=+375291234567, 123456789
ADMINS=

# Where the SQLite database (and auto-generated key) live
DATA_DIR=./data

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# How long a browser stays signed in
WEB_SESSION_DAYS=30

# If the server was down at a message's send time, still send it when it is
# at most this many seconds late; otherwise mark it as missed.
MISSED_GRACE_SECONDS=60

# Page that links the college's daily timetable PDFs, and how often to check
# it for new or changed days. Leave SCHEDULE_URL empty to turn fetching off.
SCHEDULE_URL=https://mrk.bsuir.by/en/schedule/
SCHEDULE_REFRESH_MINUTES=15

# --- Docker only (make up / docker compose) ---------------------------------
# Host address and port the container is published on. Keep 127.0.0.1 unless
# it sits behind an HTTPS reverse proxy.
# BIND=127.0.0.1
# PORT=8080
# Host folder mounted as the data directory (same one `make run` uses).
# DATA_PATH=./data
# Network MTU for the container. 1420 works behind WireGuard-style VPNs.
# DOCKER_MTU=1420
